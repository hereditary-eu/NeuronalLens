---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Graph from "../components/Graph.astro";
import Timeseries from "../components/Timeseries.astro";
---

<Layout title="The Neuronal Network of the Brain.">
  <main>
    <h1>Neuronal Brain <span class="text-gradient">Network</span></h1>
    <p>
      To take a closer look at the data, select a Neuron on the left using your
      mouse. Connected Neurons will be highlighted in the graph and you will
      find timeseries visualisations on the right.
    </p>
    <div style="display: flex;">
      <Graph />
      <Timeseries selector={[0, 200]} />
    </div>
    <!-- <p class="instructions">
      To get started, open the directory <code>src/pages</code> in your project.<br
      />
      <strong>Code Challenge:</strong> Tweak the "Welcome to Astro" message above.
    </p> -->
    <ul role="list" class="link-card-grid">
      <Card
        href="https://zenodo.org/records/10519411"
        title="Dataset: Neuronal Network Simulation of the Brain"
        body="Proof of Concept dataset: IEEE Vis Contest 2023."
      />
      <Card
        href="https://hereditary-project.eu/"
        title="EU Project: HEREDITARY"
        body="Part of EU Horizon: HetERogeneous sEmantic Data integratIon for the guT-bRain interplaY."
      />
      <Card
        href="https://github.com/"
        title="Source Code: Extend your own"
        body="Take a look at the source code to implement your own visualisation solution."
      />
    </ul>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1rem;
    width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
  }
  .astro-a {
    position: absolute;
    top: -32px;
    left: 50%;
    transform: translatex(-50%);
    width: 220px;
    height: auto;
    z-index: -1;
  }
  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 0.4em;
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  .instructions {
    margin-bottom: 2rem;
    border: 1px solid rgba(var(--accent-light), 25%);
    background: linear-gradient(
      rgba(var(--accent-dark), 66%),
      rgba(var(--accent-dark), 33%)
    );
    padding: 1.5rem;
    border-radius: 8px;
  }
  .instructions code {
    font-size: 0.8em;
    font-weight: bold;
    background: rgba(var(--accent-light), 12%);
    color: rgb(var(--accent-light));
    border-radius: 4px;
    padding: 0.3em 0.4em;
  }
  .instructions strong {
    color: rgb(var(--accent-light));
  }
  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    gap: 2rem;
    padding: 0;
  }
</style>
