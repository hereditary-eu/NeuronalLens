<div id="three-d-view"></div>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { positions, selector } from "./store";

  const viewport = document.getElementById("three-d-view");
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(viewport.clientWidth, viewport.clientHeight);
  viewport.appendChild(renderer.domElement);

  const camera = new THREE.PerspectiveCamera(45, viewport.clientWidth / viewport.clientHeight, 1, 500);
  camera.position.set(0, 0, 300);
  camera.lookAt(0, 0, 0);

  const controls = new OrbitControls(camera, renderer.domElement);
  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  pointer.set(0, 0);

  function onPointerMove(event) {
    // calculate pointer position in normalized device coordinates
    // (-1 to +1) for both components
    pointer.x = (event.clientX / viewport.clientWidth) * 2 - 1;
    pointer.y = -(event.clientY / viewport.clientHeight) * 2 + 1;
  }

  controls.enableDamping = true;
  controls.rotateSpeed = 1.4;
  controls.dampingFactor = 0.9;
  controls.enableZoom = true;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.9;

  window.addEventListener(
    "resize",
    () => {
      renderer.setSize(viewport.clientWidth, viewport.clientHeight);
      camera.aspect = viewport.clientWidth / viewport.clientHeight;
      camera.updateProjectionMatrix();
    },
    false
  );

  var originalBrainCenter = new THREE.Vector3();
  const scene = new THREE.Scene();
  const material = new THREE.LineBasicMaterial({ color: 0x00aaff });
  const points = positions.get().map((p) => new THREE.Vector3(p.x, p.y, p.z));
  const uncentered = new THREE.BufferGeometry().setFromPoints(points);
  uncentered.computeBoundingBox();
  uncentered.boundingBox.getCenter(originalBrainCenter);
  const brainGeometry = uncentered.center();
  const line = new THREE.Points(brainGeometry, material);
  scene.add(line);

  function render() {
    requestAnimationFrame(render);

    controls.update();
    raycaster.setFromCamera(pointer, camera);
    // const intersects = raycaster.intersectObjects(scene.children);
    // console.log("intersects", intersects);
    // for (let i = 0; i < intersects.length; i++) {
    //   intersects[i].object.material.color.set(0xff0000);
    // }
    renderer.render(scene, camera);
  }

  selector.subscribe((newSelection) => {
    console.log("New Selection", newSelection);
    if (!newSelection.x) return;

    const geometry = new THREE.SphereGeometry(2.5, 32, 16);
    const material = new THREE.MeshBasicMaterial({ color: 0x5bba4a });
    const sphere = new THREE.Mesh(geometry, material);
    const p = originalBrainCenter.negate().add(new THREE.Vector3(newSelection.x, newSelection.y, newSelection.z));
    geometry.translate(p.x, p.y, p.z);
    scene.add(sphere);

    // brainGeometry.applyMatrix4(new THREE.Matrix4().makeScale(0.2, 0.2, 0.5));
  });

  viewport.addEventListener("pointermove", onPointerMove);

  render();
</script>

<style>
  #three-d-view {
    width: 100%;
    height: 520px;
  }
</style>
