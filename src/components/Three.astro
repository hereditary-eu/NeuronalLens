---

---

<div id="three-controls">
  <label for="explosion-slider">Explosion: <span id="explosion-value">1.00</span></label>
  <input id="explosion-slider" type="range" min="0.8" max="1.2" step="0.01" value="1.0" />
  <label>
    <input id="explosion-mode" type="checkbox" />
    Directional
  </label>
  <button id="reset-explosion">Reset</button>

  <label
    >Color
    <select id="sel-color">
      <option value="area">Area</option>
      <option value="activity" disabled>Activity</option>
    </select>
  </label>
  <label
    >Overlay
    <select id="sel-overlay">
      <option value="none">None</option>
      <option value="activity" disabled>Activity</option>
    </select>
  </label>
  <label
    >Size
    <select id="sel-size">
      <option value="constant">Constant</option>
      <option value="activity" disabled>Activity</option>
    </select>
  </label>

  <span id="sim-loading" style="color:#aaa;font-size:0.8rem"></span>
</div>
<div id="three-d-view"></div>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import NpyLoader from "npyjs";
  import { positions, selector, currentTime } from "./store";

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const viewport = document.getElementById("three-d-view")!;
  const slider = document.getElementById("explosion-slider") as HTMLInputElement;
  const valueLabel = document.getElementById("explosion-value")!;
  const modeCheckbox = document.getElementById("explosion-mode") as HTMLInputElement;
  const resetBtn = document.getElementById("reset-explosion")!;
  const selColor = document.getElementById("sel-color") as HTMLSelectElement;
  const selOverlay = document.getElementById("sel-overlay") as HTMLSelectElement;
  const selSize = document.getElementById("sel-size") as HTMLSelectElement;
  const simLoading = document.getElementById("sim-loading")!;

  // ── Renderer / camera / controls ─────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({
    antialias: true,
    alpha: true,
    preserveDrawingBuffer: window.matchMedia("print").matches,
  });
  renderer.setSize(viewport.clientWidth, viewport.clientHeight);
  viewport.appendChild(renderer.domElement);

  const camera = new THREE.PerspectiveCamera(45, viewport.clientWidth / viewport.clientHeight, 1, 500);
  camera.position.set(0, 0, 300);
  camera.lookAt(0, 0, 0);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.rotateSpeed = 1.4;
  controls.dampingFactor = 0.9;
  controls.enableZoom = true;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.9;

  window.addEventListener("resize", () => {
    renderer.setSize(viewport.clientWidth, viewport.clientHeight);
    camera.aspect = viewport.clientWidth / viewport.clientHeight;
    camera.updateProjectionMatrix();
  });

  // ── Neuron data ───────────────────────────────────────────────────────────
  const neurons = positions.get();
  const N = neurons.length;

  const uniqueAreas = Array.from(new Set(neurons.map((n) => n.area)));
  const areaColorMap = new Map<string, THREE.Color>();
  uniqueAreas.forEach((area, i) => {
    areaColorMap.set(area, new THREE.Color().setHSL(i / uniqueAreas.length, 0.85, 0.55));
  });

  let sumX = 0,
    sumY = 0,
    sumZ = 0;
  for (const n of neurons) {
    sumX += n.x;
    sumY += n.y;
    sumZ += n.z;
  }
  const brainCenter = new THREE.Vector3(sumX / N, sumY / N, sumZ / N);

  interface AreaData {
    center: THREE.Vector3;
    direction: THREE.Vector3;
    indices: number[];
  }
  const areaMap = new Map<string, AreaData>();
  for (let i = 0; i < N; i++) {
    const n = neurons[i]!;
    if (!areaMap.has(n.area))
      areaMap.set(n.area, { center: new THREE.Vector3(), direction: new THREE.Vector3(), indices: [] });
    const ad = areaMap.get(n.area)!;
    ad.indices.push(i);
    ad.center.x += n.x;
    ad.center.y += n.y;
    ad.center.z += n.z;
  }
  for (const [, ad] of areaMap) {
    ad.center.divideScalar(ad.indices.length);
    ad.direction.copy(ad.center).sub(brainCenter).normalize();
  }

  const areaFactor = new Map<string, number>();
  for (const area of uniqueAreas) areaFactor.set(area, 1.0);

  // ── Geometry & shader ─────────────────────────────────────────────────────
  const basePositions = new Float32Array(N * 3);
  const colArray = new Float32Array(N * 3);
  const areaColorsArr = new Float32Array(N * 3);
  const sizeArray = new Float32Array(N).fill(2.0);

  for (let i = 0; i < N; i++) {
    const n = neurons[i]!;
    basePositions[i * 3] = n.x - brainCenter.x;
    basePositions[i * 3 + 1] = n.y - brainCenter.y;
    basePositions[i * 3 + 2] = n.z - brainCenter.z;
    const c = areaColorMap.get(n.area) ?? new THREE.Color(1, 1, 1);
    colArray[i * 3] = areaColorsArr[i * 3] = c.r;
    colArray[i * 3 + 1] = areaColorsArr[i * 3 + 1] = c.g;
    colArray[i * 3 + 2] = areaColorsArr[i * 3 + 2] = c.b;
  }

  const geometry = new THREE.BufferGeometry();
  const posAttr = new THREE.BufferAttribute(new Float32Array(basePositions), 3);
  const colAttr = new THREE.BufferAttribute(colArray, 3);
  const sizeAttr = new THREE.BufferAttribute(sizeArray, 1);
  posAttr.setUsage(THREE.DynamicDrawUsage);
  colAttr.setUsage(THREE.DynamicDrawUsage);
  sizeAttr.setUsage(THREE.DynamicDrawUsage);
  geometry.setAttribute("position", posAttr);
  geometry.setAttribute("aColor", colAttr);
  geometry.setAttribute("aSize", sizeAttr);

  const material = new THREE.ShaderMaterial({
    vertexShader: `
      attribute vec3 aColor;
      attribute float aSize;
      varying vec3 vColor;
      void main() {
        vColor = aColor;
        vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = aSize * (300.0 / -mvPos.z);
        gl_Position = projectionMatrix * mvPos;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      void main() {
        vec2 c = gl_PointCoord - 0.5;
        if (dot(c, c) > 0.25) discard;
        gl_FragColor = vec4(vColor, 1.0);
      }
    `,
  });

  const pointCloud = new THREE.Points(geometry, material);
  const scene = new THREE.Scene();
  scene.add(pointCloud);

  // ── Selection ring ────────────────────────────────────────────────────────
  const ringGeo = new THREE.BufferGeometry();
  const ringPos = new THREE.BufferAttribute(new Float32Array(3), 3);
  ringPos.setUsage(THREE.DynamicDrawUsage);
  ringGeo.setAttribute("position", ringPos);

  const ringMat = new THREE.ShaderMaterial({
    transparent: true,
    depthTest: false,
    vertexShader: `
      void main() {
        vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = 14.0 * (300.0 / -mvPos.z);
        gl_Position = projectionMatrix * mvPos;
      }
    `,
    fragmentShader: `
      void main() {
        float r = length(gl_PointCoord - 0.5);
        float ring = step(0.40, r) * step(r, 0.5);
        if (ring < 0.5) discard;
        gl_FragColor = vec4(1.0, 1.0, 1.0, 1.0);
      }
    `,
  });

  const ringMesh = new THREE.Points(ringGeo, ringMat);
  ringMesh.visible = false;
  scene.add(ringMesh);

  let selectedNeuronIdx = -1;

  // ── Simulation data ───────────────────────────────────────────────────────
  let activityData: Float32Array | null = null;
  let activityMin = 0,
    activityMax = 1;
  let nNeurons = N;
  const localIdToCol = new Map<number, number>();

  // Normalize a raw metric value to [0, 1]
  function normalize(v: number): number {
    return Math.max(0, Math.min(1, (v - activityMin) / (activityMax - activityMin || 1)));
  }

  // Get normalized metric value for neuron i at row offset; returns null if unavailable
  function metricValue(metric: string, i: number, rowOffset: number): number | null {
    if (metric === "activity" && activityData) {
      const col = localIdToCol.get(neurons[i]!.local_id) ?? -1;
      if (col < 0) return null;
      return normalize(activityData[rowOffset + col]!);
    }
    return null;
  }

  // Compute per-area average of a metric at rowOffset
  function areaAverages(metric: string, rowOffset: number): Map<string, number> {
    const sums = new Map<string, number>();
    const counts = new Map<string, number>();
    for (let i = 0; i < N; i++) {
      const area = neurons[i]!.area;
      const v = metricValue(metric, i, rowOffset);
      if (v === null) continue;
      sums.set(area, (sums.get(area) ?? 0) + v);
      counts.set(area, (counts.get(area) ?? 0) + 1);
    }
    const avgs = new Map<string, number>();
    for (const area of uniqueAreas) {
      avgs.set(area, (sums.get(area) ?? 0) / (counts.get(area) ?? 1));
    }
    return avgs;
  }

  // ── Visual update ─────────────────────────────────────────────────────────
  const BASE_SIZE = 2.0;
  const OVERLAY_MAX = 50; // units, much smaller than main explosion (80)

  function applyVisuals(step: number) {
    const rowOffset = Math.floor(step / 100) * nNeurons;
    const colorMetric = selColor.value;
    const overlayMetric = selOverlay.value;
    const sizeMetric = selSize.value;

    const overlayAvgs = overlayMetric !== "none" ? areaAverages(overlayMetric, rowOffset) : null;

    const tmp = new THREE.Color();
    for (let i = 0; i < N; i++) {
      const n = neurons[i]!;
      const factor = areaFactor.get(n.area) ?? 1.0;
      const bx = basePositions[i * 3]!;
      const by = basePositions[i * 3 + 1]!;
      const bz = basePositions[i * 3 + 2]!;

      // ── position: main explosion ──
      let px: number, py: number, pz: number;
      const ad = areaMap.get(n.area)!;
      if (modeCheckbox.checked) {
        const scale = (factor - 1.0) * 80 * globalFactor;
        px = bx + ad.direction.x * scale;
        py = by + ad.direction.y * scale;
        pz = bz + ad.direction.z * scale;
      } else {
        const acx = ad.center.x - brainCenter.x;
        const acy = ad.center.y - brainCenter.y;
        const acz = ad.center.z - brainCenter.z;
        const eff = factor * globalFactor;
        px = acx * eff + (bx - acx);
        py = acy * eff + (by - acy);
        pz = acz * eff + (bz - acz);
      }

      // ── position: overlay ──
      if (overlayAvgs) {
        const avg = overlayAvgs.get(n.area) ?? 0;
        px += ad.direction.x * avg * OVERLAY_MAX;
        py += ad.direction.y * avg * OVERLAY_MAX;
        pz += ad.direction.z * avg * OVERLAY_MAX;
      }
      posAttr.setXYZ(i, px, py, pz);

      // ── color ──
      if (colorMetric === "activity") {
        const v = metricValue("activity", i, rowOffset);
        if (v !== null) {
          tmp.setHSL((1 - v) * 0.67, 1.0, 0.5);
          colAttr.setXYZ(i, tmp.r, tmp.g, tmp.b);
        }
      } else {
        colAttr.setXYZ(i, areaColorsArr[i * 3]!, areaColorsArr[i * 3 + 1]!, areaColorsArr[i * 3 + 2]!);
      }

      // ── size ──
      if (sizeMetric === "activity") {
        const v = metricValue("activity", i, rowOffset) ?? 0.5;
        sizeAttr.setX(i, 0.5 + v * 4.0); // range 0.5–4.5
      } else {
        sizeAttr.setX(i, BASE_SIZE);
      }
    }

    posAttr.needsUpdate = true;
    colAttr.needsUpdate = true;
    sizeAttr.needsUpdate = true;

    // Keep ring in sync with the (possibly exploded) selected neuron position
    if (selectedNeuronIdx >= 0) {
      ringPos.setXYZ(0, posAttr.getX(selectedNeuronIdx), posAttr.getY(selectedNeuronIdx), posAttr.getZ(selectedNeuronIdx));
      ringPos.needsUpdate = true;
    }
  }

  let globalFactor = 1.0;

  function refresh() {
    applyVisuals(currentTime.get());
  }

  // ── Sim data loading ──────────────────────────────────────────────────────
  async function loadSimData(): Promise<void> {
    simLoading.textContent = "Loading simulation data…";
    try {
      const meta = (await (await fetch("/sim-meta.json")).json()) as {
        neuron_ids: number[];
        n_steps: number;
        n_neurons: number;
      };
      nNeurons = meta.n_neurons;
      meta.neuron_ids.forEach((id, idx) => localIdToCol.set(id, idx));

      const loader = new NpyLoader();
      const result = await loader.load("/sim-activity.npy");
      activityData = result.data as Float32Array;

      activityMin = Infinity;
      activityMax = -Infinity;
      for (let i = 0; i < activityData.length; i++) {
        const v = activityData[i]!;
        if (v < activityMin) activityMin = v;
        if (v > activityMax) activityMax = v;
      }

      // Unlock activity options in all dropdowns
      for (const sel of [selColor, selOverlay, selSize]) {
        const opt = sel.querySelector<HTMLOptionElement>("option[value='activity']");
        if (opt) opt.disabled = false;
      }
      simLoading.textContent = "";
      refresh();
    } catch {
      simLoading.textContent = "sim data unavailable";
    }
  }

  loadSimData();

  selColor.addEventListener("change", refresh);
  selOverlay.addEventListener("change", refresh);
  selSize.addEventListener("change", refresh);

  currentTime.subscribe(() => refresh());

  // ── Explosion controls ────────────────────────────────────────────────────
  slider.addEventListener("input", () => {
    globalFactor = parseFloat(slider.value);
    valueLabel.textContent = globalFactor.toFixed(2);
    refresh();
  });
  modeCheckbox.addEventListener("change", refresh);
  resetBtn.addEventListener("click", () => {
    for (const area of uniqueAreas) areaFactor.set(area, 1.0);
    slider.value = "1.0";
    globalFactor = 1.0;
    valueLabel.textContent = "1.00";
    refresh();
  });

  // ── Raycaster ─────────────────────────────────────────────────────────────
  const raycaster = new THREE.Raycaster();
  raycaster.params.Points = { threshold: 2 };
  const pointer = new THREE.Vector2();

  viewport.addEventListener("pointermove", (event) => {
    const rect = viewport.getBoundingClientRect();
    pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
  });

  viewport.addEventListener("click", () => {
    raycaster.setFromCamera(pointer, camera);
    const intersects = raycaster.intersectObject(pointCloud);
    if (intersects.length > 0) {
      const idx = intersects[0]!.index ?? -1;
      if (idx >= 0) {
        const clickedArea = neurons[idx]?.area;
        if (clickedArea) {
          for (const area of uniqueAreas) areaFactor.set(area, area === clickedArea ? 1.2 : 1.0);
          refresh();
        }
      }
    }
  });

  // ── Selection ring ────────────────────────────────────────────────────────
  selector.subscribe((sel) => {
    const idx = neurons.findIndex((n) => n.local_id === sel.local_id);
    selectedNeuronIdx = idx;
    if (idx < 0) { ringMesh.visible = false; return; }
    ringPos.setXYZ(0, posAttr.getX(idx), posAttr.getY(idx), posAttr.getZ(idx));
    ringPos.needsUpdate = true;
    ringMesh.visible = true;
  });

  // ── Render loop ───────────────────────────────────────────────────────────
  function render() {
    requestAnimationFrame(render);
    controls.update();
    renderer.render(scene, camera);
  }
  render();
</script>

<style>
  #three-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
    color: white;
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  #explosion-slider {
    width: 120px;
    accent-color: rgb(var(--accent-light, 100 108 255));
  }
  #reset-explosion {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    cursor: pointer;
  }
  #three-controls select {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
  }
  #three-d-view {
    width: 100%;
    height: 520px;
  }
</style>
