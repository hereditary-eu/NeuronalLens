---
// Timeseries component – per-neuron monitor plots using Observable Plot
---

<div id="ts-controls">
  <button id="ts-play-pause">▶ Play</button>
  <button id="ts-shift-left">⏮ Back</button>
  <label id="ts-network-label">
    <input id="ts-network-refetch" type="checkbox" checked />
    Update network with time
  </label>
</div>
<astro-timeseries>
  <div id="ts-plot-container"></div>
</astro-timeseries>

<style>
  #ts-controls {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  #ts-controls button {
    padding: 0.2rem 0.7rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    cursor: pointer;
    font-size: 0.85rem;
  }
  #ts-controls button:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  #ts-network-label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: white;
    cursor: pointer;
    user-select: none;
  }
  astro-timeseries {
    display: block;
  }
  astro-timeseries svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  #ts-plot-container {
    width: 100%;
  }
</style>

<script>
  import * as Plot from "@observablehq/plot";
  import * as d3 from "d3";
  import { selector, currentTime, fetchMonitor, MAX_STEP, STEP_SIZE } from "./models";
  import type { MonitorRow } from "./models";

  const T_SIZE = 8; // triangle half-width / height

  function makeWrapper(): { wrapper: HTMLDivElement; overlay: SVGSVGElement } {
    const wrapper = document.createElement("div");
    wrapper.style.cssText = "position: relative; margin-bottom: 5px;";
    const overlay = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    overlay.style.cssText = "position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;";
    wrapper.appendChild(overlay);
    return { wrapper, overlay };
  }

  function renderLine(overlay: SVGSVGElement, xScale: d3.ScaleLinear<number, number>, t: number) {
    overlay.innerHTML = "";
    const x = xScale(t);
    const { height: h } = overlay.getBoundingClientRect();

    const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
    g.style.cursor = "ew-resize";
    g.setAttribute("pointer-events", "all");

    const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
    line.setAttribute("x1", String(x));
    line.setAttribute("y1", "0");
    line.setAttribute("x2", String(x));
    line.setAttribute("y2", String(h));
    line.setAttribute("stroke", "white");
    line.setAttribute("stroke-width", "1.5");
    line.setAttribute("stroke-dasharray", "4,3");
    line.setAttribute("pointer-events", "none");
    g.appendChild(line);

    // wide transparent hit area
    const hit = document.createElementNS("http://www.w3.org/2000/svg", "rect");
    hit.setAttribute("x", String(x - T_SIZE));
    hit.setAttribute("y", "0");
    hit.setAttribute("width", String(T_SIZE * 2));
    hit.setAttribute("height", String(h));
    hit.setAttribute("fill", "transparent");
    g.appendChild(hit);

    // triangle pointing down, base at top edge
    const topTri = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
    topTri.setAttribute("points", `${x - T_SIZE},0 ${x + T_SIZE},0 ${x},${T_SIZE * 1.4}`);
    topTri.setAttribute("fill", "white");
    g.appendChild(topTri);

    // triangle pointing up, base at bottom edge
    const botTri = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
    botTri.setAttribute("points", `${x - T_SIZE},${h} ${x + T_SIZE},${h} ${x},${h - T_SIZE * 1.4}`);
    botTri.setAttribute("fill", "white");
    g.appendChild(botTri);

    overlay.appendChild(g);

    return g;
  }

  function attachDrag(g: SVGGElement, overlay: SVGSVGElement, xScale: d3.ScaleLinear<number, number>) {
    g.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      const [r0, r1] = xScale.range() as [number, number];

      const onMove = (ev: PointerEvent) => {
        const rect = overlay.getBoundingClientRect();
        const px = ev.clientX - rect.left;
        const clamped = Math.max(r0, Math.min(r1, px));
        currentTime.set(Math.round(xScale.invert(clamped)));
      };

      const onUp = () => {
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("pointerup", onUp);
      };

      window.addEventListener("pointermove", onMove);
      window.addEventListener("pointerup", onUp);
    });
  }

  // ── Play / Pause ──────────────────────────────────────────────────────────
  const PLAY_INTERVAL_MS = 80;

  const playPauseBtn = document.getElementById("ts-play-pause") as HTMLButtonElement;
  const shiftLeftBtn = document.getElementById("ts-shift-left") as HTMLButtonElement;

  let playTimer: ReturnType<typeof setInterval> | null = null;

  function setPlaying(on: boolean) {
    if (on) {
      playTimer = setInterval(() => {
        const next = currentTime.get() + STEP_SIZE;
        currentTime.set(next > MAX_STEP ? 0 : next);
      }, PLAY_INTERVAL_MS);
      playPauseBtn.textContent = "⏸ Pause";
    } else {
      if (playTimer !== null) {
        clearInterval(playTimer);
        playTimer = null;
      }
      playPauseBtn.textContent = "▶ Play";
    }
  }

  playPauseBtn.addEventListener("click", () => setPlaying(playTimer === null));
  shiftLeftBtn.addEventListener("click", () => {
    setPlaying(false);
    currentTime.set(0);
  });

  class AstroTimeseries extends HTMLElement {
    constructor() {
      super();
      const container = this.querySelector<HTMLElement>("#ts-plot-container")!;

      // one xScale shared across both overlays (same data, same step domain)
      let xScale: d3.ScaleLinear<number, number> | null = null;
      const overlays: SVGSVGElement[] = [];

      const redrawAll = (t: number) => {
        if (!xScale) return;
        for (const ov of overlays) {
          const g = renderLine(ov, xScale, t);
          attachDrag(g, ov, xScale);
        }
      };

      selector.subscribe(async (neuron) => {
        const slice = await fetchMonitor(neuron.local_id);

        container.innerHTML = "";
        overlays.length = 0;

        const plotDefs: { key: "activity" | "dampening" }[] = [{ key: "activity" }, { key: "dampening" }];

        const plotWidth = container.getBoundingClientRect().width || 900;
        const plotHeight = 300;

        for (const { key } of plotDefs) {
          const plotEl = Plot.plot({
            marks: [Plot.lineY(slice, { x: "step", y: key, z: null, stroke: "dampening", tip: "x" })],
            width: plotWidth,
            height: plotHeight,
            style: "--plot-background: black",
          });

          if (!xScale) {
            const sc = (plotEl as any).scale("x");
            if (sc) xScale = d3.scaleLinear().domain(sc.domain).range(sc.range);
          }

          const { wrapper, overlay } = makeWrapper();
          wrapper.insertBefore(plotEl, overlay); // plot behind overlay
          overlays.push(overlay);
          container.appendChild(wrapper);
        }

        redrawAll(currentTime.get());
      });

      currentTime.subscribe((t) => redrawAll(t));
    }
  }

  customElements.define("astro-timeseries", AstroTimeseries);
</script>
