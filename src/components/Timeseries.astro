---

<astro-timeseries data-plot-options={JSON.stringify(options)}>
  <!-- <Fragment set:html={plottyplot.outerHTML} /> -->
</astro-timeseries>

<script>
  import * as Plot from "@observablehq/plot";
  import * as d3 from "d3";
  import { selector } from "./store";

  class AstroTimeseries extends HTMLElement {
    constructor() {
      super();
      selector.subscribe(async (neuron) => {
        const monitorCsv = await (
          await fetch(`/monitors/0_${neuron.local_id}.csv`)
        ).text();
        const monitor = d3.dsvFormat(";").parseRows(monitorCsv, (row) => {
          return {
            step: +row[0],
            fired: +row[1],
            fired_fraction: +row[2],
            activity: +row[3],
            dampening: +row[4],
            current_calcium: +row[5],
            target_calcium: +row[6],
            synaptic_input: +row[7],
            background_input: +row[8],
            grown_axons: +row[9],
            connected_axons: +row[10],
            grown_dendrites: +row[11],
            connected_dendrites: +row[12],
          };
        });
        console.log(monitor);
        this.innerHTML = "";
        this.appendChild(
          Plot.plot({
            marks: [
              Plot.lineY(monitor.slice(0, 400), {
                x: "step",
                y: "activity",
                z: null,
                stroke: "dampening",
                tip: "x",
              }),
            ],
            width: 800,
            height: 450,
            style: "--plot-background: black",
          })
        );
      });
    }
  }
  customElements.define("astro-timeseries", AstroTimeseries);
</script>
