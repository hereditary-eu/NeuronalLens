---

<astro-graph data-plot-options={JSON.stringify(options)}>
  <!-- <Fragment set:html={plottyplot.outerHTML} /> -->
</astro-graph>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../penguins.json";
  import { selector } from "./store";

  class AstroGraph extends HTMLElement {
    constructor() {
      super();
      this.innerHTML = "";
      const theplot = Plot.plot({
        marks: [
          Plot.delaunayMesh(penguins, {
            x: "culmen_depth_mm",
            y: "culmen_length_mm",
            z: "species",
            stroke: "species",
            strokeOpacity: 0.5,
          }),
          Plot.dot(penguins, {
            x: "culmen_depth_mm",
            y: "culmen_length_mm",
            fill: "species",
            tip: "x",
          }),
          // Plot.click(
          //   penguins,
          //   Plot.pointerX({ x: "culmen_depth_mm", y: "culmen_length_mm" }),
          //   (event, data) => {
          //     console.log(data);
          //   }
          // ),
        ],
        width: 800,
        height: 450,
        style: "--plot-background: black",
      });
      this.appendChild(theplot);
      this.addEventListener("click", (ev) => {
        console.log(theplot.value);
        if (theplot.value !== null)
          selector.set([
            (Math.random() * penguins.length) / 2,
            penguins.length / 2 + (Math.random() * penguins.length) / 2,
          ]);
      });
    }
  }
  customElements.define("astro-graph", AstroGraph);
</script>
