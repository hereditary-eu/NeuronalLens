---
// Graph component – 2D scatter of neuron positions using Observable Plot
---

<astro-graph id="graph"></astro-graph>

<script>
  import * as Plot from "@observablehq/plot";
  import * as d3 from "d3";
  import { positions, selector } from "./store";
  import type { NeuronPosition } from "./store";

  function getEveryNth<T>(arr: T[], nth: number): T[] {
    const result: T[] = [];
    for (let index = 0; index < arr.length; index += nth) {
      result.push(arr[index]!);
    }
    return result;
  }

  const selectedPositions = getEveryNth(positions.get(), 12);

  const rawConnections = await d3.dsv(" ", "/rank_0_step_0_out_network.txt");
  const outConnections = rawConnections.map((d) => ({
    source_id: +(d["source_id"] ?? 0),
    target_id: +(d["target_id"] ?? 0),
    weight: +(d["weight"] ?? 0),
  }));

  const selectedNeuronConnections: Record<number, Record<number, number>> = {};
  for (const conn of outConnections) {
    if (!selectedNeuronConnections[conn.source_id]) {
      selectedNeuronConnections[conn.source_id] = {};
    }
    selectedNeuronConnections[conn.source_id]![conn.target_id] = conn.weight;
  }

  function selectNeuron(neuron: NeuronPosition) {
    selector.set(neuron);
  }

  class AstroGraph extends HTMLElement {
    constructor() {
      super();
      selector.subscribe(() => {
        const selected = selector.get();
        const connectionHeuristic = (neuron: NeuronPosition): number => {
          return selectedNeuronConnections[selected.local_id]?.[neuron.local_id] ?? 0;
        };

        const theplot = Plot.plot({
          marks: [
            Plot.delaunayMesh(selectedPositions, {
              x: "x",
              y: "y",
              strokeOpacity: 0.5,
            }),
            Plot.dot(selectedPositions, {
              x: "x",
              y: "y",
              tip: "xy",
              fill: (n: NeuronPosition) => (connectionHeuristic(n) === 0 ? "black" : "white"),
              r: (n: NeuronPosition) => connectionHeuristic(n) * 2 || 0.15,
              stroke: "area",
            }),
          ],
          width: 1100,
          height: 600,
          style: "--plot-background: black",
        });

        this.innerHTML = "";
        this.appendChild(theplot);
        theplot.addEventListener("click", () => {
          const val = (theplot as HTMLElement & { value: NeuronPosition | null }).value;
          if (val !== null && val !== undefined) selectNeuron(val);
        });
      });
    }
  }

  customElements.define("astro-graph", AstroGraph);
  if (selectedPositions[0]) selectNeuron(selectedPositions[0]);
</script>
